# Copy to .env and fill in. The real .env is gitignored.
DUKAN_SECRET_KEY=change-me-to-a-long-random-string
# Dev uses SQLite; production uses PostgreSQL (psycopg driver):
# DUKAN_DATABASE_URL=postgresql+psycopg://dukan:dukan@localhost:5432/dukan
DUKAN_DATABASE_URL=sqlite:///./dukan_dev.db
DUKAN_ACCESS_TTL_MINUTES=15
DUKAN_REFRESH_TTL_DAYS=30
