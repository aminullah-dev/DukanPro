# Copy to .env and fill in. The real .env is gitignored.
# Signs access tokens: at least 32 random characters, or the server refuses to
# start. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DUKAN_SECRET_KEY=
# First-run owner setup code (12+ characters). Unset: the server makes one at
# startup and logs it.
# DUKAN_BOOTSTRAP_TOKEN=
# Dev uses SQLite; production uses PostgreSQL (psycopg driver):
# DUKAN_DATABASE_URL=postgresql+psycopg://dukan:dukan@localhost:5432/dukan
DUKAN_DATABASE_URL=sqlite:///./dukan_dev.db
DUKAN_ACCESS_TTL_MINUTES=15
DUKAN_REFRESH_TTL_DAYS=30
