<?xml version="1.0" encoding="utf-8"?>
<!-- No app data leaves the device through cloud backup or device transfer: the
     local database holds customers' debts, costs and the sync outbox, and
     secure storage holds the sign-in (review F047). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
