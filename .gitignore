# ── Dart / Flutter ───────────────────────────────────────────────
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
# Every pubspec.lock is committed. CI resolves the app and each package on its
# own, and an unlocked resolve tests versions nobody here has run. None of these
# packages is published, so "libraries leave their lockfile out" does not apply.
# (Git takes `#` as a comment only at the start of a line: a comment after a
# pattern becomes part of it, which is how `!app/pubspec.lock` never matched.)
**/doc/api/
.fvm/

# Flutter platform build artifacts
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/macos/Pods/
app/**/ephemeral/
app/windows/flutter/ephemeral/
app/android/.gradle/
app/android/local.properties
app/android/key.properties
*.iml

# ── Python (server) ──────────────────────────────────────────────
server/.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# ── Local databases ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Secrets / local config ───────────────────────────────────────
*.env
.env.*
!.env.example

# ── OS / editor ──────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.log

# Server backups made by deploy/docker-compose.yml
deploy/backups/
