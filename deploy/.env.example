# Copy to .env next to docker-compose.yml and fill in. Keep it private.

# The name the app reaches the server by. Its DNS must point at this machine.
DUKAN_DOMAIN=api.example.com

# Signs sign-in tokens: 32+ random characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DUKAN_SECRET_KEY=

# The first owner's setup code (12+ characters). Leave it out and the server
# prints one in its log at the first start.
# DUKAN_BOOTSTRAP_TOKEN=

# The database password: random, and written only here.
POSTGRES_PASSWORD=

# Days of daily backups kept in ./backups.
BACKUP_KEEP_DAYS=14
